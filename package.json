{
  "name": "dsh-onestep",
  "version": "1.0.1",
  "description": "Onestep 会话舞台：把 DSH 会话主界面变成「1 个焦点会话 + 最多 12 个候场会话」的多会话舞台。",
  "type": "module",
  "license": "MIT",
  "author": "Huaxingmo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ABCDEFGHIJKLMOPQRSTUVWXY/dsh-onestep.git"
  },
  "homepage": "https://github.com/ABCDEFGHIJKLMOPQRSTUVWXY/dsh-onestep#readme",
  "bugs": {
    "url": "https://github.com/ABCDEFGHIJKLMOPQRSTUVWXY/dsh-onestep/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-stage",
    "multi-session",
    "workspace"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0 || >=0.2.1-rc.5 <0.2.2-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && npm run build:check && npm run i18n:check && npm run compat:engines && npm run docs:check",
    "i18n:check": "node scripts/p2/check-i18n.mjs",
    "i18n:hotswap": "node scripts/p2/i18n-hotswap.mjs",
    "p2:verify": "node scripts/p2/verify/run-all.mjs",
    "compat:inventory": "node scripts/p2/compat/inventory.mjs",
    "compat:smoke": "node scripts/p2/compat/smoke.mjs",
    "compat:engines": "node scripts/p2/compat/check-engines.mjs",
    "review:verify": "node scripts/review/run-all.mjs",
    "p0:install": "node scripts/p0/install/install-p0.mjs",
    "p0:verify": "node scripts/p0/verify/playwright-driver.mjs",
    "p3:verify": "node scripts/p3/verify/run-all.mjs",
    "p3:hygiene": "node scripts/p3/verify/release-hygiene.mjs",
    "docs:check": "node scripts/p2/shots/check-release.mjs",
    "p4:verify": "node scripts/p4/verify/run-all.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
